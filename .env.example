# Shared local development environment. Keep .env untracked and never put real keys here.

# Local collector (Tier 1), default port differs from SaaS service.
COLLECTOR_DB=collector.db
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8001
COLLECTOR_TENANT_ID=demo-tenant
COLLECTOR_ID=collector-001
SAAS_INGEST_URL=http://127.0.0.1:8000/api/v1/ingest/telemetry
SAAS_API_KEY=
STALE_AFTER_SECONDS=300
SIMULATOR_ENABLED=true
PSEUDONYM_SALT=replace-with-a-random-local-value
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300
RETRY_INTERVAL_SECONDS=2
HEALTH_GOOD_THRESHOLD=60
HEALTH_FAIR_THRESHOLD=75
HEALTH_POOR_THRESHOLD=90

# Central SaaS backend (Tier 2).
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=backend/saas_platform.db
STALE_TELEMETRY_SECONDS=120
ANOMALY_COOLDOWN_SECONDS=300
CORRELATION_WINDOW_SECONDS=600
ANOMALY_BASELINE_WINDOW_SECONDS=3600
INCIDENT_RECOVERY_WINDOW_SECONDS=300

# Frontend (public configuration only; never put SAAS_API_KEY in VITE_*).
VITE_SAAS_API_BASE_URL=/api/v1
VITE_LOCAL_COLLECTOR_URL=/collector
VITE_TENANT_ID=
VITE_DATA_MODE=live
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
