# Environment configuration template for CICADA 2026 Central SaaS Backend
# Copy to .env and configure as needed for local development

# Application settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Database settings (SQLite local file path)
DATABASE_PATH=backend/saas_platform.db

# Ingestion & Health Engine thresholds
STALE_TELEMETRY_SECONDS=120
ANOMALY_COOLDOWN_SECONDS=300
CORRELATION_WINDOW_SECONDS=600
